{
  "expo": {
    "name": "Ahmed",
    "slug": "ahmed",
    "version": "1.0.22",
    "orientation": "portrait",
    "scheme": "ahmed",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1e104e",
          "imageWidth": 200
        }
      ],
      "expo-font"
    ],
    "updates": {
      "enabled": true,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/85d588cc-f97a-4907-a248-0e778d83d674",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "sa.pm.ahmed",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "sa.pm.ahmed",
      "versionCode": 23,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e104e"
      }
    },
    "extra": {
      "apiUrl": "https://ahmed.pm.sa/api",
      "buildLabel": "2026-10-25-new-sms-sender",
      "eas": {
        "projectId": "85d588cc-f97a-4907-a248-0e778d83d674"
      }
    }
  }
}
